{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "rootDir": "js",
    "moduleResolution": "bundler",
    "target": "es2020",
    "module": "esnext",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["js/main.js", "js/Datepicker.js", "js/DateRangePicker.js", "js/types.js"],
  "exclude": ["node_modules", "test", "demo", "dist"]
}
